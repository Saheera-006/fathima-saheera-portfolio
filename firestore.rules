rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content is public to read. Only the configured admin account can write.
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "uVBdzOT6EDcHgE9OxeCz9EWAeEB2";
    }

    // Keep the connection-test document public if the app uses it for connectivity checks.
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
